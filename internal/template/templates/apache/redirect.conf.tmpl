<VirtualHost *:80>
    ServerName {{ .ServerName }}
{{- range .Aliases }}
    ServerAlias {{ . }}
{{- end }}

    Alias /.well-known/acme-challenge {{ .ACMEChallengeDir }}
    <Directory {{ .ACMEChallengeDir }}>
        Require all granted
    </Directory>

    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^(.*)$ {{ .RedirectScheme }}://{{ .RedirectTarget }}$1 [R=301,L]

    ErrorLog {{ .LogDir }}/apache-error.log
    CustomLog {{ .LogDir }}/apache-access.log combined
</VirtualHost>
{{ if .TLS }}
<VirtualHost *:443>
    ServerName {{ .ServerName }}
{{- range .Aliases }}
    ServerAlias {{ . }}
{{- end }}

    SSLEngine on
    SSLCertificateFile {{ .CertDir }}/fullchain.pem
    SSLCertificateKeyFile {{ .CertDir }}/privkey.pem

    # Un domaine redirigé doit l'être aussi en HTTPS (D43) : ce bloc n'est rendu
    # que si le certificat présent couvre ce domaine, et un visiteur qui arrive
    # en https ne doit pas voir une erreur de nom.
    RewriteEngine On
    RewriteRule ^(.*)$ {{ .RedirectScheme }}://{{ .RedirectTarget }}$1 [R=301,L]

    ErrorLog {{ .LogDir }}/apache-error.log
    CustomLog {{ .LogDir }}/apache-access.log combined
</VirtualHost>
{{- end }}

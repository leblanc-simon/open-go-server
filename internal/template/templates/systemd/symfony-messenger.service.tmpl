[Unit]
Description={{ .Description }} (instance %i)
PartOf={{ .Target }}
After=network.target{{ if .AfterBroker }} rabbitmq-server.service{{ end }}

# Un service qui échoue en boucle ne doit pas saturer la machine : au-delà du
# seuil, systemd cesse de le relancer et l'unité reste en échec, visible. Ces
# deux réglages appartiennent à [Unit] : placés dans [Service], systemd les
# ignore et la protection n'existe pas.
StartLimitBurst=10
StartLimitIntervalSec=600

[Service]
Type=simple
User={{ .User }}
Group={{ .Group }}
WorkingDirectory={{ .Workdir }}
{{- range $key := sorted .Environment }}
Environment={{ systemdEnv $key (index $.Environment $key) }}
{{- end }}
# L'interpréteur passe par le lien géré : une bascule de version PHP ne réécrit
# aucune unité (D30).
ExecStart={{ .Interpreter }} {{ .Console }} messenger:consume {{ .Transport }} \
  --time-limit={{ .TimeLimit }} --memory-limit={{ .MemoryLimit }} --limit={{ .Limit }} -v
Restart=always
RestartSec={{ .RestartSec }}
# Messenger termine le message en cours sur SIGTERM : lui laisser le temps évite
# de perdre un traitement à chaque redémarrage.
KillSignal=SIGTERM
TimeoutStopSec={{ .StopTimeout }}
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ .Identifier }}

# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# Le tiret rend le chemin facultatif : « var » est créé par l'application, non
# par ogs, et un service déclaré avant le déploiement du code ne doit pas
# refuser de démarrer sur un espace de noms impossible à installer (226).
ReadWritePaths=-{{ .Workdir }}/var -{{ .RunDir }}
UMask={{ .UMask }}

[Install]
WantedBy={{ .Target }}

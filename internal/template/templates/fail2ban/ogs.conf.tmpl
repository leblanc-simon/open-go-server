# Prisons dérivées du parc. Elles ne recouvrent aucune prison de
# l'administrateur : toutes portent le préfixe « ogs- », et ce fichier n'écrit
# **aucune section commune**. Une telle section posée dans jail.d n'est pas locale
# à son fichier — fail2ban fusionne jail.conf, jail.d/*.conf et jail.local dans un
# même analyseur — et imposerait bantime, findtime, maxretry et ignoreip à toutes
# les prisons de la machine, y compris celles qu'ogs n'a pas écrites. Les réglages
# sont donc portés par chaque prison, où ils sont tout aussi valides.
# Les filtres sont ceux livrés par fail2ban.
#
# Un point de vigilance, qui explique la forme de ce fichier : fail2ban refuse de
# démarrer sur une prison dont aucun journal n'existe, et s'arrête alors
# entièrement — les prisons valides comprises. Les chemins ci-dessous sont donc
# énumérés un à un, et seuls ceux qui existaient au moment de l'apply y figurent.
{{ range .Jails }}
[{{ .Name }}]
enabled  = true
filter   = {{ .Filter }}
port     = {{ .Port }}
backend  = {{ .Backend }}
maxretry = {{ .MaxRetry }}
bantime  = {{ .BanTime }}
findtime = {{ .FindTime }}
ignoreip = {{ join " " .IgnoreIP }}
{{- if .LogPaths }}
logpath  = {{ range $i, $p := .LogPaths }}{{ if $i }}
           {{ end }}{{ $p }}{{ end }}
{{- end }}
{{ end }}

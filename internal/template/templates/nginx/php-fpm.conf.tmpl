server {
    listen 80;
    listen [::]:80;
    server_name {{ .ServerName }}{{ range .Aliases }} {{ . }}{{ end }};

    # Le challenge ACME doit répondre avant toute redirection.
    location ^~ /.well-known/acme-challenge/ {
        root {{ .ACMEChallenge }};
        default_type "text/plain";
    }
{{ if .TLS }}
    location / {
        return 301 https://{{ .ServerName }}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ .ServerName }}{{ range .Aliases }} {{ . }}{{ end }};

    ssl_certificate     {{ .CertDir }}/fullchain.pem;
    ssl_certificate_key {{ .CertDir }}/privkey.pem;
{{- if .HSTS }}
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
{{- end }}
{{- end }}
    root {{ .Docroot }};
    index {{ .FrontController }} index.html;
    access_log {{ .LogDir }}/nginx-access.log;
    error_log  {{ .LogDir }}/nginx-error.log;
    client_max_body_size {{ .ClientMaxBodySize }};

    # Un lien symbolique n'est suivi que vers ce qui appartient à son auteur.
    # www-data est membre du groupe de chaque projet (D25) : suivre tout lien lui
    # ferait servir les fichiers d'un voisin, désignés par un lien posé dans ce
    # docroot, que le pool du projet — sous son propre compte — ne peut pas lire.
    # Le contrôle part de la racine du projet, et non du docroot : le home
    # appartient à l'utilisateur (D51), qui y remplace sans privilège le docroot
    # lui-même par un lien.
    disable_symlinks if_not_owner from={{ .Root }};
{{- if .Noindex }}

    # Préproduction : interdiction d'indexation.
    add_header X-Robots-Tag "noindex, nofollow" always;
    location = /robots.txt {
        return 200 "User-agent: *\nDisallow: /\n";
    }
{{- end }}

    # Fichiers et répertoires cachés — .git, .env, .htaccess — et métadonnées de
    # dépendances : la racine d'un dépôt tiré par « git pull » est souvent le
    # docroot lui-même (php-plain, Prestashop). /.well-known/ (RFC 8615) reste
    # servi : le challenge ACME et security.txt y vivent. En tête des regex :
    # nginx retient la première qui correspond.
    location ~ /\.(?!well-known/) {
        deny all;
    }
    location ~ /composer\.(json|lock)$ {
        deny all;
    }

    # try_files éprouve $ogs_fichier, et non $uri : les deux ne diffèrent que
    # pour « / », le docroot lui-même, que www-data traverse sans pouvoir le lire
    # (0710, D51) et que disable_symlinks ferait ouvrir en lecture. Le fragment
    # de portée serveur d'ogs définit la variable. « / » reste ainsi dans
    # location /, donc sous ses surcharges (D63), et atteint le front controller
    # quelle que soit la méthode.
{{ if eq .AppKind "php-prestashop" }}
    # Prestashop s'appuie sur .htaccess, que nginx ne lit pas : les règles de
    # réécriture doivent être fournies ici, sans quoi le site n'est qu'à moitié
    # fonctionnel (images, pages de catégorie, API). Le deuxième essai cherche un
    # répertoire : pour « / », c'est le nom réservé .ogs-accueil/ (fragment d'ogs).
    location / {
        try_files $ogs_fichier $ogs_fichier/ /{{ .FrontController }}$is_args$args;
        include {{ .IncludeDocroot }}/*.conf;
    }
    rewrite ^/api/?(.*)$ /webservice/dispatcher.php?url=$1 last;
    rewrite ^/([0-9])(-[\w-]+)?/(.+)\.(jpg|webp|png|avif)$ /img/p/$1/$1$2.$4 last;
    rewrite ^/([0-9])([0-9])(-[\w-]+)?/(.+)\.(jpg|webp|png|avif)$ /img/p/$1/$2/$1$2$3.$5 last;
    rewrite ^/c/([0-9]+)(-[\w-]+)?/(.+)\.(jpg|webp|png|avif)$ /img/c/$1$2.$4 last;
    rewrite ^/c/([\w-]+)/(.+)\.(jpg|webp|png|avif)$ /img/c/$1.$3 last;

    # Répertoires qui ne doivent jamais être servis.
    location ~ ^/(app|bin|cache|classes|config|controllers|docs|localization|override|src|tests|tools|translations|travis-scripts|vendor|var)/ {
        deny all;
    }
{{- else }}
    # Front controller unique : tout passe par {{ .FrontController }}.
    location / {
        try_files $ogs_fichier /{{ .FrontController }}$is_args$args;
        include {{ .IncludeDocroot }}/*.conf;
    }
{{- end }}

    location ~ ^/{{ .FrontController }}(/|$) {
        fastcgi_pass {{ .FPMPass }};
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $document_root;
        fastcgi_param HTTPS {{ if .TLS }}on{{ else }}off{{ end }};
        internal;
    }

    # Aucun autre script PHP ne doit être exécutable : un fichier déposé dans un
    # répertoire d'upload ne devient pas un point d'entrée.
    location ~ \.php$ {
        return 404;
    }
{{- range .Blocks }}

    # bloc {{ .Name }}
{{ indent 4 .Content }}
{{- end }}

    # Surcharges locales, éditées à la main hors de la gestion d'ogs. Le masque
    # rend l'inclusion facultative : un répertoire absent ou vide ne fait pas
    # broncher nginx, là où un chemin littéral introuvable serait fatal.
    include {{ .IncludeVHost }}/*.conf;
}

#!/bin/bash
# Faux crontab de la source, au contrat de celui de Debian : « no crontab for » et
# code 1 pour -l ou -r sans crontab. Le spool est $FAUX_SOURCE/spool.
spool="$FAUX_SOURCE/spool" user="$(id -un)" action=installer fichier=''
while (($#)); do
    case "$1" in
        -u) user="$2"; shift 2 ;;
        -l) action=lister; shift ;;
        -r) action=retirer; shift ;;
        *)  fichier="$1"; shift ;;
    esac
done
case $action in
    lister)    [[ -f "$spool/$user" ]] || { echo "no crontab for $user" >&2; exit 1; }; cat "$spool/$user" ;;
    retirer)   [[ -f "$spool/$user" ]] || { echo "no crontab for $user" >&2; exit 1; }; rm -f "$spool/$user" ;;
    installer) mkdir -p "$spool"; cat -- "${fichier:--}" >"$spool/$user" ;;
esac
